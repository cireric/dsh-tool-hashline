# Pin the content-addressable store inside the repo. Without this pnpm falls back
# mid-install when the global store cannot hard-link across drives, which leaves a
# half-linked tree behind.
store-dir=.pnpm-store

# Windows without symlink privileges: pnpm's default isolated linker creates
# directory junctions, and this Node build's ESM resolver does not follow them
# (fs.realpathSync returns the logical path), so every transitive dependency of a
# linked package becomes ERR_MODULE_NOT_FOUND. A hoisted tree uses real
# directories, which resolves normally.
node-linker=hoisted
