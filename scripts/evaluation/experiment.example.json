{
  "id": "custom-model-probe",
  "kind": "probe",
  "editPayloadVersion": 2,
  "requestEvidence": { "version": 1 },
  "limits": [
    "Single-point starter case only; does not establish model benefit or support promotion."
  ],
  "provider": {
    "plugin": "@deepseek-ai/dsh-llm-deepseek-api-key",
    "credentialEnv": "DEEPSEEK_API_KEY",
    "config": {
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    }
  },
  "model": {
    "provider": "deepseek-official",
    "model": null,
    "parameters": {
      "maxTokens": 4096
    }
  },
  "comparison": ["stock-edit", "hashline-default", "hashline-fallback"],
  "samples": { "repetitions": 1, "seed": 7 },
  "order": "interleaved",
  "budget": {
    "maxModelRequests": null,
    "maxTotalTokens": null,
    "timeoutMs": 120000
  },
  "passConditions": {
    "semantics": "per-arm-cohort-count-and-per-run-tokens-v2",
    "firstCandidateScope": { "include": ["status-update"], "exclude": [] },
    "minFirstCandidateCorrect": null,
    "maxTotalTokensPerTask": null
  },
  "tasks": [
    {
      "id": "status-update",
      "family": "single-point",
      "class": "known-applicable",
      "targets": [
        { "id": "account-status", "path": "account.txt", "goal": "Change only status from pending to active", "class": "known-applicable" }
      ],
      "batchBoundary": "first-edit-program",
      "initial": { "account.txt": "status=pending\nowner=example\n" },
      "expected": { "account.txt": "status=active\nowner=example\n" },
      "prompt": "In account.txt change status from pending to active. Preserve the other content."
    }
  ]
}
