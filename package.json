{
  "name": "dsh-tool-hashline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm -r check && tsc -p tsconfig.tests.json",
    "test": "pnpm build && pnpm -r test",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "check:preset": "node scripts/check-preset.mjs",
    "test:profile": "node scripts/test-profile.mjs",
    "test:ptc": "vitest run --config vitest.ptc.config.ts",
    "check:tests": "tsc -p tsconfig.tests.json",
    "install:profile": "node scripts/install-profile.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./presets/ptc-hashline/preset.patch.yml"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./presets/*": "./presets/*",
    "./presets/ptc-hashline/intent-gate-watchdog.mjs": "./presets/ptc-hashline/intent-gate-watchdog.mjs"
  },
  "files": [
    "presets",
    "package.json",
    "README.md"
  ]
}
