{
  "name": "dsh-tool-hashline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm -r check && tsc -p tsconfig.tests.json",
    "test": "pnpm build && pnpm -r test",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "check:preset": "node scripts/check-preset.mjs",
    "test:profile": "node scripts/test-profile.mjs",
    "test:ptc": "vitest run --config vitest.ptc.config.ts",
    "check:tests": "tsc -p tsconfig.tests.json",
    "install:profile": "node scripts/install-profile.mjs",
    "test:delivery": "node scripts/delivery-acceptance-cli.mjs",
    "sync:check": "node scripts/sync-check.mjs",
    "test:host-policy": "node scripts/test-default-edit-host.mjs",
    "eval:freeze": "node scripts/evaluation/driver.mjs freeze",
    "eval:check": "node scripts/evaluation/driver.mjs check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./presets/ptc-hashline/preset.patch.yml"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./presets/*": "./presets/*",
    "./presets/ptc-hashline/intent-gate-watchdog.mjs": "./presets/ptc-hashline/intent-gate-watchdog.mjs",
    "./presets/ptc-hashline/operations/*.mjs": "./presets/ptc-hashline/operations/*.mjs"
  },
  "files": [
    "presets",
    "package.json",
    "README.md"
  ]
}
